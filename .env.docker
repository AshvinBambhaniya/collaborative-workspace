# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connections (using container names)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/purple_merit?schema=public"
MONGO_URI="mongodb://mongo:27017/purple_merit"
REDIS_HOST="redis"
REDIS_PORT=6379

# Security secrets (Use strong secrets in production!)
JWT_SECRET="docker-jwt-secret-key-change-me"
JWT_REFRESH_SECRET="docker-refresh-secret-key-change-me"
